# Copy this file to backend/.env and edit. Real environment variables win over
# anything set here. Restart the backend after changing it. Never commit .env.
#
# Check what is active:  curl http://127.0.0.1:8000/api/v1/health
#                        curl http://127.0.0.1:8000/api/v1/config

# --- Extraction engine -------------------------------------------------------
#   local  - deterministic, runs on this machine; nothing is sent anywhere (default)
#   groq   - Groq openai/gpt-oss-20b locates values; everything is verified locally
#   hybrid - both, cross-checked; falls back to local (visibly) if Groq fails
EXTRACTION_ENGINE=local

# The groq and hybrid engines send statement TEXT to Groq. Both of these are
# required before that can happen; with either missing, those engines are
# refused with a clear error and never substituted.
ALLOW_EXTERNAL_LLM_CALLS=false
GROQ_API_KEY=

# Only openai/gpt-oss-20b is accepted; any other value is a configuration error.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60
# Retries done by the Groq SDK itself (connection errors, 429, 5xx).
GROQ_MAX_RETRIES=2
# low | medium | high - reasoning budget of gpt-oss-20b.
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=8192
# Input tokens per request. 3500 suits the free tier (~8K tokens/minute); raise
# it on paid tiers to use fewer, larger requests.
GROQ_CHUNK_MAX_INPUT_TOKENS=3500
# Total time a run may spend waiting for rate-limit windows before a chunk fails.
GROQ_RATE_LIMIT_MAX_WAIT_SECONDS=90
GROQ_SEED=7
# What the model reads.
#   markdown - the statement as Markdown: transaction tables from the local table
#              detector (one cell per column, so an empty debit or credit cell
#              stays empty), balance/totals lines outside the table, all other
#              text verbatim, plus the layout reader's notes. Falls back to
#              "lines" automatically if the Markdown would lose printed text.
#   lines    - the layout lines with their horizontal spacing (before 2026-10.3).
GROQ_INPUT=markdown

# --- Security ----------------------------------------------------------------
#   none  - a single local user; anyone who can reach the API sees everything.
#           Use only on a trusted machine.
#   token - every request needs "Authorization: Bearer <token>"; users see only
#           their own documents.
AUTH_MODE=none
# user:token pairs, comma separated; tokens must be at least 16 characters.
# API_TOKENS=alice:<long-random-token>,bob:<another-long-random-token>
# Delete documents (file + extracted data) older than this many days. 0 = keep.
RETENTION_DAYS=0
# CORS_ORIGINS=["https://statements.example.internal"]

# --- Limits ------------------------------------------------------------------
# MAX_FILE_SIZE_BYTES=26214400
# MAX_PAGES=200
# PROCESSING_WORKERS=2

# --- Storage -------------------------------------------------------------------
# DATABASE_URL=sqlite:///C:/path/to/statements.db
# UPLOAD_DIR=C:/path/to/uploads
# Copy the database aside before applying schema migrations (recommended).
DB_BACKUP_BEFORE_MIGRATION=true

# --- Document processing -------------------------------------------------------
# Layout analysis.
#   geometric   - deterministic, ~1 ms/page (default)
#   layout      - PP-DocLayout_plus-L on its own, ~7 s/page
#   ppstructure - the full PP-StructureV3 pipeline, ~84 s/page, finest regions
#   auto        - the layout model if installed, else geometric
STRUCTURE_ENGINE=geometric

# OCR for images and scanned PDFs (pages with a text layer never need it).
#   auto      - Tesseract if installed, else RapidOCR, else PaddleOCR (default)
#   rapidocr  - RapidOCR first: pip-installable, ~5-8 s/page on CPU. Its bundled
#               models read Latin script and Chinese; other scripts need their own models.
#   tesseract - Tesseract first, ~0.8 s/page, needs the binary and language packs
#   paddleocr - PP-OCRv5 first, ~50 s/page, needs the Paddle packages
OCR_ENGINE=auto
# OCR_DPI=200

# Leave false on Windows: paddlepaddle 3.3.1 crashes in its oneDNN path.
PADDLE_ENABLE_MKLDNN=false
# PADDLE_TEXT_DET_MAX_SIDE=960

# --- Confidence bands ------------------------------------------------------------
# CONFIDENCE_HIGH=0.90
# CONFIDENCE_REVIEW=0.70
